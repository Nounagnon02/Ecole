storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*
storage/framework/testing/*
bootstrap/cache/*

tests/
phpunit.xml
.phpunit.result.cache

.git/
.github/
.gitignore
.idea/
.vscode/

*.md
docker-compose*.yml
Dockerfile
.dockerignore
