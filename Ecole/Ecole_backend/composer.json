{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "dedoc/scramble": "^0.13.41",
        "endroid/qr-code": "^6.0",
        "erusev/parsedown": "^1.7",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.7",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "*",
        "pragmarx/google2fa-laravel": "^3.0",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-permission": "^6.0",
        "stancl/tenancy": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.8",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "Advisory Laravel 11 — à lever par une montée en Laravel 12",
                "PKSA-3r5d-mb8f-1qw9": "Advisory Laravel 11 — à lever par une montée en Laravel 12",
                "PKSA-mdq4-51ck-6kdq": "Advisory Laravel 11 — à lever par une montée en Laravel 12",
                "PKSA-8qx3-n5y5-vvnd": "Advisory Laravel 11 — à lever par une montée en Laravel 12",
                "PKSA-q46n-4fdk-zjr4": "Advisory Laravel 11 — à lever par une montée en Laravel 12",
                "PKSA-qzrn-rnz3-85w1": "Advisory Laravel 11 — à lever par une montée en Laravel 12",
                "PKSA-w7xr-vk7n-rstm": "Advisory Laravel 11 — à lever par une montée en Laravel 12"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
