APP_ENV=testing
# Clé de test fixe et publique — elle ne chiffre aucune donnée réelle.
# Ne jamais réutiliser cette valeur en production.
APP_KEY=base64:cNW8Y/mA0nO4MaPZsiz+MING3V3g0ZjWATNgYFgL1KQ=
APP_DEBUG=true
APP_URL=http://localhost

# Base de test en mémoire : aucun identifiant à versionner.
# Un mot de passe de base réel figurait ici et se trouve dans l'historique Git
# (commits 38963e0 et suivants) — il doit être considéré comme compromis
# et changé sur tout serveur où il est encore en service.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_DRIVER=log
TELESCOPE_ENABLED=false
BILLING_PROVIDER=stub
