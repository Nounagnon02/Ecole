# Build de production.
#
# `VITE_API_URL` doit pointer vers l'API réelle. Laissé vide, le client retombe
# sur `/api` en relatif : correct uniquement si l'API est servie sous le même
# domaine que le front. Toute autre origine doit être renseignée ici — et
# figurer dans le `connect-src` du CSP de `vercel.json`, sans quoi le
# navigateur bloquera les appels.
#
# L'ancienne valeur (`https://your-production-api.com/api`) était un
# gabarit : un build l'embarquait tel quel et visait un domaine inexistant.
VITE_API_URL=
VITE_APP_ENV=production
