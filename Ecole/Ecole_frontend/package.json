{
  "name": "ecole-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sentry/react": "^10.75.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.4.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.18.2",
    "laravel-echo": "^2.3.7",
    "lucide-react": "^0.263.1",
    "pusher-js": "^8.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.7.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "zustand": "^4.5.7"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "fetch:api-schema": "curl -s ${API_URL:-http://localhost:8000}/docs/api.json -o openapi/schema.json",
    "generate:api-types": "openapi-typescript openapi/schema.json -o src/shared/lib/api-types.generated.ts",
    "generate:api-client": "npm run fetch:api-schema && npm run generate:api-types"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "cross-fetch": "^4.1.0",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  }
}
