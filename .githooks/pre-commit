#!/bin/sh
# Scan de secrets, format PHP (Pint) et lint JS (ESLint) sur ce qui est
# indexé, avant le commit.
#
# Opt-in : `git config core.hooksPath .githooks` (une fois, par dépôt local).
# Chaque étape prévient et laisse passer si son outil n'est pas installé,
# plutôt que de bloquer un commit légitime -- la CI reste le vrai filet de
# sécurité (job "secrets" pour les fuites, "lint"/"style" pour le reste,
# elle-même non bloquante sur le style — voir frontend.yml/backend.yml) ;
# ceci n'est qu'un raccourci pour attraper les mêmes choses plus tôt.
#
# Pas de `set -e` : chaque étape décide elle-même si son échec doit bloquer
# le commit (voir le lint ci-dessous, seul cas qui le fait) -- un `set -e`
# global couperait le script au premier `$?` non nul, avant même d'avoir pu
# le lire.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# Seul ce qui part dans le commit est corrigé, et seulement quand c'est sans
# risque. Un fichier indexé en partie (`git add -p`) garde des modifications
# volontairement laissées hors du commit : le corriger puis le ré-indexer en
# entier les y ferait partir. Ceux-là ne sont que vérifiés (ESLint, sur la
# version indexée) ou signalés (Pint). Aucun fichier hors du commit n'est modifié.
#
# split_staged <pathspec>... remplit $fully (indexés en entier) et $partly
# (indexés en partie), un chemin par ligne.
split_staged() {
  fully=''
  partly=''
  staged=$(git diff --cached --name-only --diff-filter=ACM -- "$@")
  [ -z "$staged" ] && return 0
  while IFS= read -r f; do
    if git diff --quiet -- "$f"; then
      fully="$fully$f
"
    else
      partly="$partly$f
"
    fi
  done <<EOF
$staged
EOF
}

# --- Secrets (gitleaks) -----------------------------------------------
# Seule étape qui bloquait déjà le commit avant l'ajout du format/lint
# ci-dessous : gitleaks était alors la dernière commande du script, et son
# code de sortie devenait donc celui du hook. Ce n'est plus vrai maintenant
# qu'il y a une suite -- vérifié et propagé explicitement.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks introuvable -- scan de secrets ignoré localement (la CI le fera)."
  echo "[pre-commit] installer : https://github.com/gitleaks/gitleaks#installing"
elif ! gitleaks protect --staged --redact --config "$ROOT/.gitleaks.toml"; then
  exit 1
fi

# --- Format PHP (Pint) --------------------------------------------------
# Les fichiers indexés en entier, et eux seuls, sont reformatés puis
# ré-indexés, pour que la version corrigée parte dans le commit. (L'ancien
# `pint --dirty` reformatait aussi les fichiers modifiés mais non indexés.)
split_staged 'Ecole/Ecole_backend/*.php'
if [ -n "$fully$partly" ]; then
  if [ -x "$ROOT/Ecole/Ecole_backend/vendor/bin/pint" ]; then
    if [ -n "$fully" ]; then
      printf '%s' "$fully" | sed 's#^Ecole/Ecole_backend/##' | tr '\n' '\0' \
        | (cd "$ROOT/Ecole/Ecole_backend" && xargs -0 vendor/bin/pint --quiet) || true
      printf '%s' "$fully" | tr '\n' '\0' | xargs -0 git add --
    fi
    if [ -n "$partly" ]; then
      printf '[pre-commit] Pint : indexés en partie, non reformatés :\n%s' "$partly"
    fi
  else
    echo "[pre-commit] Pint introuvable (composer install côté backend) -- format ignoré localement."
  fi
fi

# --- Lint JS/JSX (ESLint) ------------------------------------------------
# `--fix` corrige ce qui peut l'être et ré-indexe le résultat, comme Pint
# ci-dessus. `--quiet` : n'échoue que sur de vraies erreurs, jamais sur les
# avertissements (`no-unused-vars`, etc.) -- CI elle-même les traite en
# `continue-on-error` (voir frontend.yml), un hook local ne doit pas être
# plus strict que la CI qu'il imite.
split_staged 'Ecole/Ecole_frontend/src/*.js' 'Ecole/Ecole_frontend/src/*.jsx'
if [ -n "$fully$partly" ]; then
  if [ -x "$ROOT/Ecole/Ecole_frontend/node_modules/.bin/eslint" ]; then
    lint_status=0
    if [ -n "$fully" ]; then
      printf '%s' "$fully" | sed 's#^Ecole/Ecole_frontend/##' | tr '\n' '\0' \
        | (cd "$ROOT/Ecole/Ecole_frontend" && xargs -0 node_modules/.bin/eslint --fix --quiet) || lint_status=1
      printf '%s' "$fully" | tr '\n' '\0' | xargs -0 git add --
    fi
    # Indexés en partie : pas de `--fix`, mais la version indexée, celle qui
    # part dans le commit, est vérifiée quand même.
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      git show ":$f" | (cd "$ROOT/Ecole/Ecole_frontend" \
        && node_modules/.bin/eslint --quiet --stdin --stdin-filename "${f#Ecole/Ecole_frontend/}") || lint_status=1
    done <<EOF
$partly
EOF
    if [ "$lint_status" -ne 0 ]; then
      echo "[pre-commit] ESLint a trouvé de vraies erreurs (pas de simples avertissements) -- commit bloqué."
      exit 1
    fi
  else
    echo "[pre-commit] ESLint introuvable (npm ci côté frontend) -- lint ignoré localement."
  fi
fi
